# Copy to .env.worker (ignored). Never use EXPO_PUBLIC_ for these values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Prices verified at https://developers.openai.com/api/docs/models/gpt-5-mini (2026-10-22).
# Other models require both explicit prices; review prices before changing models.
# OPENAI_INPUT_USD_PER_MILLION=
# OPENAI_OUTPUT_USD_PER_MILLION=
# Use existing local Firebase CLI login, or leave false and configure ADC externally.
FIREBASE_CLI_AUTH=true
# Optional: use installed Chrome instead of `npx playwright install chromium`.
GENERATOR_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
